PORT_HTTP=3001
# Postgres propio (en el VPS: host "postgres" de la red data). TypeORM crea el esquema solo (synchronize).
DB_HOST=postgres
DB_PORT=5432
DB_NAME=youdrive
DB_USERNAME=youdrive
DB_PASSWORD=
# "true" solo para bases externas que exigen SSL (Railway, Neon…).
DB_SSL=false
JWT_SECRET=
SESSION_SECRET=
# Header que el front manda en cada pedido; los mismos valores que NEXT_PUBLIC_CUSTOM_HEADERS_KEY/VALUE en Vercel.
CUSTOM_HEADER_KEY=
CUSTOM_HEADER_VALUE=
# Login con Google (redirect de passport). Sin client ID y secret reales, ese login falla; el resto anda.
GOOGLE_CLIENT_ID=x
GOOGLE_CLIENT_SECRET=x
CALLBACK_URL=https://api-youdrive.emacuello.dev/auth/google/redirect
GOOGLE_REDIRECT_FRONT=https://youdrive.emacuello.dev/auth
LOGIN_URL=https://youdrive.emacuello.dev/login
# Stripe: sin la clave real, pagar un alquiler falla. Stripe vuelve a la API y la API redirige al front.
STRIPE_PRIVATE_KEY=pendiente
INTERNAL_API_SUCESS=https://api-youdrive.emacuello.dev/rentals/sucess
INTERNAL_API_CANCEL=https://api-youdrive.emacuello.dev/rentals/cancel
SUCCES_CHECK_URL=https://youdrive.emacuello.dev/successcheckout
CANCEL_CHECK_URL=https://youdrive.emacuello.dev
# Cloudinary (subir fotos) y AWS Rekognition (validar que la foto sea un auto). Sin ellas, subir imágenes falla.
CLOUDINARY_CLOUD_NAME=pendiente
CLOUDINARY_API_KEY=pendiente
CLOUDINARY_API_SECRET=pendiente
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=pendiente
AWS_SECRET_ACCESS_KEY=pendiente
# Imagen que queda al borrar la foto de perfil.
IMAGE_URL=https://res.cloudinary.com/dkent00db/image/upload/v1717555619/image%20profile%20picture%20placeholder/vqnmnefzjwscrtkfpxtw.webp
# SMTP para notificaciones. Sin credenciales, los mails fallan y la app sigue andando.
MAILER_HOST=smtp.gmail.com
MAILER_PORT=587
MAILER_AUTH_USER=pendiente
MAILER_AUTH_PASS=pendiente
MAILER_FROM="YouDrive <no-reply@mail.emacuello.dev>"
# Quién recibe los mensajes del formulario de contacto.
CONTACT_EMAIL=
